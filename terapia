<!doctype html>
<html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Psicanálise | Jadir Brito</title>
<style>
:root{--bg:#fff;--card:#f7f8fa;--text:#18202a;--muted:#667085;--line:#e4e7ec}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:Arial,sans-serif;line-height:1.7}.wrap{width:min(1040px,calc(100% - 32px));margin:auto}.top{border-bottom:1px solid var(--line);padding:18px 0;background:var(--bg)}.brand{font:700 22px Georgia,serif}.hero{padding:70px 0 42px;text-align:center}.kicker{font-size:12px;letter-spacing:.18em;font-weight:800;color:var(--muted)}h1{font:700 clamp(38px,7vw,68px)/1.05 Georgia,serif;margin:12px 0 18px}.lead{font-size:20px;color:var(--muted);max-width:760px;margin:auto;white-space:pre-line}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;padding:28px 0 60px}.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:24px}.card h2{font:700 24px Georgia,serif;margin-top:0}.card p,.content{color:var(--muted);white-space:pre-line}.content{max-width:820px;margin:auto;padding:10px 0 70px;font-size:17px}footer{border-top:1px solid var(--line);padding:28px;text-align:center;color:var(--muted)}.theme{position:fixed;right:16px;top:16px;width:44px;height:44px;border-radius:50%;border:1px solid var(--line);background:var(--card);color:var(--text);font-size:20px;cursor:pointer}html.dark{--bg:#111418;--card:#181d23;--text:#edf2f7;--muted:#c1cad4;--line:#303842;color-scheme:dark}@media(max-width:760px){.grid{grid-template-columns:1fr}.lead{font-size:18px}}
</style>
<script>(function(){const k="jb_theme";if(localStorage.getItem(k)==="dark")document.documentElement.classList.add("dark");window.theme=()=>{document.documentElement.classList.toggle("dark");localStorage.setItem(k,document.documentElement.classList.contains("dark")?"dark":"light")}})();</script></head>
<body><button class="theme" onclick="theme()" title="Alternar claro/escuro">☾ / ☀</button><header class="top"><div class="wrap"><div class="brand">JADIR BRITO</div></div></header><main>
<section class="hero"><div class="wrap"><div class="kicker">PSICANÁLISE</div><h1 id="title">Psicanálise</h1><p id="intro" class="lead">Um espaço dedicado a conteúdos sobre psicanálise, comportamento, relações humanas, emoções e autoconhecimento.</p></div></section>
<section class="wrap grid"><article class="card"><h2 id="c1t">Adolescentes</h2><p id="c1x"></p></article><article class="card"><h2 id="c2t">Autoconhecimento</h2><p id="c2x"></p></article><article class="card"><h2 id="c3t">Estudos de Psicanálise</h2><p id="c3x"></p></article></section>
<section id="body" class="content wrap"></section></main><footer>Jadir Brito — Psicanálise</footer>
<script type="module">
import{initializeApp}from"https://www.gstatic.com/firebasejs/12.3.0/firebase-app.js";import{getDatabase,ref,onValue}from"https://www.gstatic.com/firebasejs/12.3.0/firebase-database.js";
const cfg={apiKey:"AIzaSyAWs1MDxOQYjqZ5LlzC4IlXscyDs-N9xfM",authDomain:"namoro-f18ac.firebaseapp.com",databaseURL:"https://namoro-f18ac-default-rtdb.firebaseio.com",projectId:"namoro-f18ac",storageBucket:"namoro-f18ac.firebasestorage.app",messagingSenderId:"336479537433",appId:"1:336479537433:web:dd282c67e98ca196e05d88"};
const db=getDatabase(initializeApp(cfg)),D=id=>document.getElementById(id);
const defaults={c1x:"Conteúdos sobre adolescência, identidade, relações familiares, inseguranças, conflitos e desenvolvimento emocional.",c2x:"Reflexões sobre sentimentos, padrões de comportamento, escolhas, vínculos e experiências pessoais.",c3x:"Textos introdutórios sobre conceitos, história e diferentes temas relacionados à tradição psicanalítica.",body:"Esta área reúne conteúdos relacionados à psicanálise em uma página própria."};
onValue(ref(db,"therapy"),s=>{const x={...defaults,...(s.val()||{})};["title","intro","c1t","c1x","c2t","c2x","c3t","c3x","body"].forEach(k=>{if(x[k]!=null&&D(k))D(k).textContent=x[k]})});
</script></body></html>
